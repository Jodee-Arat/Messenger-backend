enum QueueActionTypeEnum {
  CREATE_CHAT
  OTHER
}

enum FriendshipStatusEnum {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

enum ChatPermissionEnum {
  SEND_MESSAGES
  EDIT_MESSAGES
  DELETE_MESSAGES
  PIN_MESSAGES
  INVITE_MEMBERS
  REMOVE_MEMBERS
  MANAGE_ROLES
  CHANGE_ROLE_INFO
  CHANGE_CHAT_INFO
  CHANGE_CHAT_NAME
  CHANGE_CHAT_AVATAR
  CREATE_ROLES
  DELETE_ROLES
}

enum GroupPermissionEnum {
  // и надо посмотреть как всё работает на фронте и добавить в бэк, те же проверки
  // Добавить подписки на изменения в группе (например, на изменение информации о группе, на добавление новых сообщений и т.д.)
  INVITE_MEMBERS
  REMOVE_MEMBERS
  CHANGE_GROUP_INFO
  CHANGE_GROUP_NAME
  CHANGE_GROUP_AVATAR
  MANAGE_ROLES
  CREATE_ROLES
  CHANGE_ROLE_INFO
  CREATE_CHATS
  DELETE_ROLES
  DELETE_GROUP
  DELETE_CHATS
}
