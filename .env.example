NODE_ENV=development

APPLICATION_PORT=4000
APPLICATION_URL=http://localhost:4000
GRAPHQL_PREFIX=/graphql
ALLOWED_ORIGIN=http://localhost:3000

JWT_SECRET=replace-with-random-32-byte-secret
JWT_EXPIRES_IN=1h

COOKIES_SECRET=replace-with-random-cookie-secret
SESSION_SECRET=replace-with-random-session-secret
SESSION_NAME=session
SESSION_DOMAIN=localhost
SESSION_MAX_AGE=30d
SESSION_HTTP_ONLY=true
SESSION_SECURE=false
SESSION_FOLDER=sessions:

POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
POSTGRES_DATABASE=postgres_mesarat
POSTGRES_URI=postgresql://postgres:replace-with-local-password@localhost:5435/postgres_mesarat

REDIS_PASSWORD=replace-with-local-redis-password
REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_URI=redis://:replace-with-local-redis-password@localhost:6381

S3_ENDPOINT=https://example.invalid
S3_REGION=ru-7
S3_ACCESS_KEY_ID=replace-with-s3-access-key
S3_SECRET_ACCESS_KEY=replace-with-s3-secret-key
S3_BUCKET_NAME=replace-with-bucket
S3_URL=https://example.invalid/
